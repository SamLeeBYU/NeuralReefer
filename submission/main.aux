\newlabel{fig:qual-results}{{9}{22}{Qualitative examples from the held-out test set, comparing raw Yellowfin images, expert annotations, and machine vision pipeline predictions. Lighter shades within a genus indicate bleached status; non-coral masks are rejected prior to final output and are not shown}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Predicted live coral cover distributions for training and held-out test images. Curves are kernel density estimates (estimated with a Gaussian kernel) of the fraction of image area labeled as live coral by the machine vision pipeline. Vertical dashed lines mark sample medians (train $\approx $ 23.8\%, test $\approx $ 25.9\%). The large overlap indicates out-of-sample generalization of the cover distribution, with minor shifts consistent with sampling variability between splits (compare Figure~\ref {fig:data_coral_cover}).}}{23}{figure.caption.14}\protected@file@percent }
\newlabel{fig:lcc_train_test}{{10}{23}{Predicted live coral cover distributions for training and held-out test images. Curves are kernel density estimates (estimated with a Gaussian kernel) of the fraction of image area labeled as live coral by the machine vision pipeline. Vertical dashed lines mark sample medians (train $\approx $ 23.8\%, test $\approx $ 25.9\%). The large overlap indicates out-of-sample generalization of the cover distribution, with minor shifts consistent with sampling variability between splits (compare Figure~\ref {fig:data_coral_cover})}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Calibration of predicted vs.\ observed live coral cover for training (left) and held-out test (right). Each point is one image; axes show LCC as a percent of image area. The dashed line marks perfect calibration (1:1). The fitted linear trend indicates mild overprediction at intermediate cover (20--40\%) and underestimation as cover approaches saturation ($\geq $80\%), a pattern consistent across splits and aligned with the negative mean bias reported in Table~\ref {tab:bias-decomposition}.}}{24}{figure.caption.15}\protected@file@percent }
\newlabel{fig:lcc-trend}{{11}{24}{Calibration of predicted vs.\ observed live coral cover for training (left) and held-out test (right). Each point is one image; axes show LCC as a percent of image area. The dashed line marks perfect calibration (1:1). The fitted linear trend indicates mild overprediction at intermediate cover (20--40\%) and underestimation as cover approaches saturation ($\geq $80\%), a pattern consistent across splits and aligned with the negative mean bias reported in Table~\ref {tab:bias-decomposition}}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Distributions of pixel-level segmentation accuracy for training and held-out test images. Accuracy is the per-image fraction of pixels correctly labeled as coral or non-coral. Curves are kernel density estimates (estimated with a Gaussian kernel). Vertical dashed lines mark sample medians (train: 93.3\%, test: 92.0\%). The substantial overlap and small train--test shift indicate stable generalization of the segmentation stage.}}{25}{figure.caption.16}\protected@file@percent }
\newlabel{fig:accuracy}{{12}{25}{Distributions of pixel-level segmentation accuracy for training and held-out test images. Accuracy is the per-image fraction of pixels correctly labeled as coral or non-coral. Curves are kernel density estimates (estimated with a Gaussian kernel). Vertical dashed lines mark sample medians (train: 93.3\%, test: 92.0\%). The substantial overlap and small train--test shift indicate stable generalization of the segmentation stage}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces True vs.\ predicted bleached coral cover (BCC) by split. Vertical dashed lines mark sample medians (Train: Actual $=4.4\%$, Predicted $=3.0\%$; Test: Actual $=4.5\%$, Predicted $=1.9\%$). Distributions are strongly right-skewed, reflecting many scenes with little bleaching (or little coral). Predicted BCC tracks the empirical shape but is left-shifted (lower medians and more mass near zero), indicating conservative bleached-area estimates. The shift is larger out of sample and is consistent with the LCC underestimation in dense scenes (Figures~\ref {fig:lcc_train_test}, \ref {fig:lcc-trend}).}}{26}{figure.caption.17}\protected@file@percent }
\newlabel{fig:bcc_results}{{13}{26}{True vs.\ predicted bleached coral cover (BCC) by split. Vertical dashed lines mark sample medians (Train: Actual $=4.4\%$, Predicted $=3.0\%$; Test: Actual $=4.5\%$, Predicted $=1.9\%$). Distributions are strongly right-skewed, reflecting many scenes with little bleaching (or little coral). Predicted BCC tracks the empirical shape but is left-shifted (lower medians and more mass near zero), indicating conservative bleached-area estimates. The shift is larger out of sample and is consistent with the LCC underestimation in dense scenes (Figures~\ref {fig:lcc_train_test}, \ref {fig:lcc-trend})}{figure.caption.17}{}}
