\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.2.1}SAM2-Based Segmentation}{8}{subsubsection.3.2.1}\protected@file@percent }
\newlabel{sec:sam2}{{3.2.1}{8}{SAM2-Based Segmentation}{subsubsection.3.2.1}{}}
\newlabel{RF1}{9}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces A visualization of the model pipeline, showing the progression of inference for a single image. Blue circle nodes represent modeling decisions made by the researcher. Images collected by the Yellowfin Surfzone ASV are paired with spatial metadata, preprocessed, and passed through a SAM2-based mask proposal system optimized for detecting both large and small coral structures. Each mask is cropped, augmented, and passed to an ensemble of CNN submodels, each with a ResNet backbone (BB) and fully connected (FC) output layer producing class logits of a prespecified dimension for each submodel $m=1,\ldots  ,M$. These logits are then projected onto the simplex through a softmax activation function to yield valid probability distributions. The probability matrices are then aggregated through a weighted ensemble to produce final mask classifications over 17 coral-related categories through a learned $M\times K$ weight matrix and model weight vector, $\bm  {\alpha }$. Masks predicted as ``non-coral'' are rejected prior to the final segmentation map construction. We compute post hoc ecological statistics such as coral cover stratified by morpho-taxonomic class and bleaching status to generate new labeled datasets for analysis.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{9}{A visualization of the model pipeline, showing the progression of inference for a single image. Blue circle nodes represent modeling decisions made by the researcher. Images collected by the Yellowfin Surfzone ASV are paired with spatial metadata, preprocessed, and passed through a SAM2-based mask proposal system optimized for detecting both large and small coral structures. Each mask is cropped, augmented, and passed to an ensemble of CNN submodels, each with a ResNet backbone (BB) and fully connected (FC) output layer producing class logits of a prespecified dimension for each submodel $m=1,\ldots ,M$. These logits are then projected onto the simplex through a softmax activation function to yield valid probability distributions. The probability matrices are then aggregated through a weighted ensemble to produce final mask classifications over 17 coral-related categories through a learned $M\times K$ weight matrix and model weight vector, $\bm {\alpha }$. Masks predicted as ``non-coral'' are rejected prior to the final segmentation map construction. We compute post hoc ecological statistics such as coral cover stratified by morpho-taxonomic class and bleaching status to generate new labeled datasets for analysis}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Tuned parameters for SAM2 segmentation and preprocessing augmentations. Segmentation parameters are tuned separately for large and small object detection, while postprocessing and augmentation parameters are shared.}}{10}{table.caption.6}\protected@file@percent }
\newlabel{tab:sam2-tuned-params}{{2}{10}{Tuned parameters for SAM2 segmentation and preprocessing augmentations. Segmentation parameters are tuned separately for large and small object detection, while postprocessing and augmentation parameters are shared}{table.caption.6}{}}
\newlabel{eq:score}{{1}{11}{SAM2-Based Segmentation}{equation.1}{}}
