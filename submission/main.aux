\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Heatmap of class-specific ensemble responsibilities. Rows correspond to the five CNN submodels, with percentages indicating each model's overall contribution to the ensemble (i.e., $\alpha _m$). Columns correspond to the 17 classes (morpho-taxonomic class $\times $ bleaching status plus non-coral), where the sum over each model's contribution is 1, by construction. Color intensity reflects the relative class-specific weights $\bm  {w}_m$, showing that individual submodels specialize in different subsets of taxa, while the ensemble balances these contributions to improve robustness.}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ensemble-heatmap}{{6}{17}{Heatmap of class-specific ensemble responsibilities. Rows correspond to the five CNN submodels, with percentages indicating each model's overall contribution to the ensemble (i.e., $\alpha _m$). Columns correspond to the 17 classes (morpho-taxonomic class $\times $ bleaching status plus non-coral), where the sum over each model's contribution is 1, by construction. Color intensity reflects the relative class-specific weights $\bm {w}_m$, showing that individual submodels specialize in different subsets of taxa, while the ensemble balances these contributions to improve robustness}{figure.caption.9}{}}
