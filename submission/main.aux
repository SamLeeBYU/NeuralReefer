\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Representative Yellowfin imagery from the SR4 region of Majuro Atoll, Marshall Islands. Panels are placed at their true acquisition time (horizontal axis) and logged camera depth below the water surface (vertical axis), selected to spread broadly across both dimensions; the two are only weakly correlated in this survey (depth and time-of-day are governed independently by the ASV's transect path and mission duration). Images illustrate variation in coral cover, species composition, and environmental conditions. Each image is a 1024$\times $1024 pixel top-down frame; across the SR4 survey, Yellowfin's depth below the water surface ranged from 1.6--18.7\,m (\ref {app:depth}; Figure~\ref {fig:depth_accuracy}). All photos in the SR4 survey were captured during a single mid-morning-to-early-afternoon window (11:18--13:54 local time).}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:raw-yellowfin-examples}{{1}{4}{Representative Yellowfin imagery from the SR4 region of Majuro Atoll, Marshall Islands. Panels are placed at their true acquisition time (horizontal axis) and logged camera depth below the water surface (vertical axis), selected to spread broadly across both dimensions; the two are only weakly correlated in this survey (depth and time-of-day are governed independently by the ASV's transect path and mission duration). Images illustrate variation in coral cover, species composition, and environmental conditions. Each image is a 1024$\times $1024 pixel top-down frame; across the SR4 survey, Yellowfin's depth below the water surface ranged from 1.6--18.7\,m (\ref {app:depth}; Figure~\ref {fig:depth_accuracy}). All photos in the SR4 survey were captured during a single mid-morning-to-early-afternoon window (11:18--13:54 local time)}{figure.caption.1}{}}
