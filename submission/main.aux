\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Confusion matrix summarizing ensemble discrimination on an out-of-sample validation set across bleaching status. Rows denote ground-truth labels (non-coral, bleached coral, and healthy coral), while columns indicate predicted classes. Cell values represent counts and row-normalized percentages. The ensemble achieves high recall for both bleached (87.2\%) and healthy coral (86.2\%) while maintaining strong rejection of non-coral instances (96.4\%).}}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:discrimination-bleaching}{{7}{19}{Confusion matrix summarizing ensemble discrimination on an out-of-sample validation set across bleaching status. Rows denote ground-truth labels (non-coral, bleached coral, and healthy coral), while columns indicate predicted classes. Cell values represent counts and row-normalized percentages. The ensemble achieves high recall for both bleached (87.2\%) and healthy coral (86.2\%) while maintaining strong rejection of non-coral instances (96.4\%)}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Confusion matrix summarizing ensemble discrimination on an out-of-sample validation set by coral morpho-taxonomic class. Rows denote ground-truth morpho-taxonomic class labels (plus non-coral and ``oddball'' classes), and columns denote predicted classes. The diagonal dominance indicates strong overall performance, with per-genus recall ranging from 73.6\% (Mounding) to 93.3\% (Finger Porites and Pocillopora), and above 80\% for all genera except Mounding corals, whose fine-branching growth form is more frequently confused with other classes. Errors are concentrated among morphologically similar classes, consistent with expectations.}}{20}{figure.caption.12}\protected@file@percent }
\newlabel{fig:discrimination-genus}{{8}{20}{Confusion matrix summarizing ensemble discrimination on an out-of-sample validation set by coral morpho-taxonomic class. Rows denote ground-truth morpho-taxonomic class labels (plus non-coral and ``oddball'' classes), and columns denote predicted classes. The diagonal dominance indicates strong overall performance, with per-genus recall ranging from 73.6\% (Mounding) to 93.3\% (Finger Porites and Pocillopora), and above 80\% for all genera except Mounding corals, whose fine-branching growth form is more frequently confused with other classes. Errors are concentrated among morphologically similar classes, consistent with expectations}{figure.caption.12}{}}
